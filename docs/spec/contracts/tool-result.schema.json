{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "error",
        "cancelled"
      ]
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 80
          },
          "message": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "maxLength": 80
            },
            "message": {
              "type": "string",
              "maxLength": 2000
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 128
          },
          "document_version_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "locator": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "docx"
                      },
                      "part": {
                        "type": "string",
                        "maxLength": 256
                      },
                      "paragraph_index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "table_index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "row": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "column": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "preview_page": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "kind",
                      "part"
                    ],
                    "additionalProperties": false,
                    "anyOf": [
                      {
                        "required": [
                          "paragraph_index"
                        ]
                      },
                      {
                        "required": [
                          "table_index",
                          "row",
                          "column"
                        ]
                      }
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "pdf"
                      },
                      "page": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "bbox": {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": 0
                        },
                        "minItems": 4,
                        "maxItems": 4,
                        "description": "[x0,y0,x1,y1]; application validates x1>=x0,y1>=y0 and page/image bounds"
                      }
                    },
                    "required": [
                      "kind",
                      "page"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "xlsx"
                      },
                      "sheet": {
                        "type": "string",
                        "maxLength": 128
                      },
                      "range": {
                        "type": "string",
                        "pattern": "^[A-Z]+[1-9][0-9]*(:[A-Z]+[1-9][0-9]*)?$"
                      }
                    },
                    "required": [
                      "kind",
                      "sheet",
                      "range"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "csv"
                      },
                      "record_start": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "record_end": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "physical_line_start": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "physical_line_end": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "kind",
                      "record_start",
                      "record_end"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "pptx"
                      },
                      "slide_id": {
                        "type": "string",
                        "maxLength": 128
                      },
                      "slide_number": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "shape_id": {
                        "type": "string",
                        "maxLength": 128
                      },
                      "notes": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "kind",
                      "slide_id",
                      "slide_number"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "image"
                      },
                      "frame": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "bbox": {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": 0
                        },
                        "minItems": 4,
                        "maxItems": 4,
                        "description": "[x0,y0,x1,y1]; application validates x1>=x0,y1>=y0 and page/image bounds"
                      }
                    },
                    "required": [
                      "kind",
                      "frame",
                      "width",
                      "height"
                    ],
                    "additionalProperties": false
                  }
                ],
                "description": "Human page/frame/row/column references are 1-based; DOCX paragraph/table indices and rows/columns are 0-based. PDF bbox points (72dpi); image bbox pixels."
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        },
        "required": [
          "source_id",
          "document_version_id",
          "locator",
          "url"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "operation_id",
    "status",
    "data",
    "warnings",
    "error",
    "source_refs"
  ],
  "additionalProperties": false
}
